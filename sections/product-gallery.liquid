{% comment %}
  Premium standalone product media gallery.
  Add through the theme editor on a product template.
  Disable the original gallery before publishing.
{% endcomment %}
{% liquid
  assign gallery_product = product
  assign media_count = gallery_product.media.size
  assign initial_media = gallery_product.selected_or_first_available_variant.featured_media
  if initial_media == blank
    assign initial_media = gallery_product.featured_media
  endif
  if initial_media == blank
    assign initial_media = gallery_product.media.first
  endif
%}

<section id="PremiumGallery-{{ section.id }}" class="tss-gallery" data-section-id="{{ section.id }}" data-product-id="{{ gallery_product.id }}" style="--tss-bg:{{ section.settings.background }};--tss-gap:{{ section.settings.spacing }}px;--tss-radius:{{ section.settings.radius }}px;--tss-thumb:{{ section.settings.thumb_width }}px;--tss-ratio:{% case section.settings.ratio %}{% when 'square' %}1{% when 'portrait' %}0.8{% when 'landscape' %}1.25{% else %}auto{% endcase %};">
  <div class="tss-gallery__layout{% unless section.settings.show_thumbs %} tss-gallery__layout--no-thumbs{% endunless %}{% if section.settings.thumb_position == 'right' %} tss-gallery__layout--right{% endif %}">
    {% if media_count > 0 %}
      {% if section.settings.show_thumbs %}
        <div class="tss-gallery__thumbs" role="group" aria-label="Product media thumbnails">
          {% for media in gallery_product.media %}
            <button class="tss-gallery__thumb{% if media.id == initial_media.id %} is-active{% endif %}" type="button" data-media-id="{{ media.id }}" data-index="{{ forloop.index0 }}" aria-label="View media {{ forloop.index }} of {{ media_count }}" aria-pressed="{% if media.id == initial_media.id %}true{% else %}false{% endif %}">
              {% if media.preview_image %}
                {{ media.preview_image | image_url: width: 220 | image_tag: loading: 'lazy', widths: '80, 120, 160, 220', sizes: '90px', alt: media.alt }}
              {% else %}
                {{ 'product-1' | placeholder_svg_tag }}
              {% endif %}
              {% unless media.media_type == 'image' %}<span class="tss-gallery__media-badge" aria-hidden="true">{% if media.media_type == 'model' %}3D{% else %}▶{% endif %}</span>{% endunless %}
            </button>
          {% endfor %}
        </div>
      {% endif %}
      <div class="tss-gallery__main" tabindex="0" aria-label="Product media viewer; use left and right arrow keys to navigate">
        {% for media in gallery_product.media %}
          <div class="tss-gallery__slide{% if media.id == initial_media.id %} is-active{% endif %}" data-media-id="{{ media.id }}" data-index="{{ forloop.index0 }}" data-media-type="{{ media.media_type }}" {% unless media.id == initial_media.id %}hidden{% endunless %}>
            {% case media.media_type %}
              {% when 'image' %}
                {{ media | image_url: width: 2000 | image_tag: loading: 'lazy', widths: '360, 540, 750, 990, 1200, 1500, 1800, 2000', sizes: '(min-width: 990px) 65vw, 100vw', class: 'tss-gallery__image', alt: media.alt }}
              {% when 'video' %}
                {{ media | video_tag: controls: true, image_size: '1200x', preload: 'none', class: 'tss-gallery__video' }}
              {% when 'external_video' %}
                {{ media | external_video_tag: class: 'tss-gallery__video' }}
              {% when 'model' %}
                {{ media | model_viewer_tag: image_size: '1200x', reveal: 'interaction', toggleable: true, class: 'tss-gallery__model' }}
              {% else %}
                {% if media.preview_image %}{{ media.preview_image | image_url: width: 1500 | image_tag: loading: 'lazy', class: 'tss-gallery__image' }}{% endif %}
            {% endcase %}
          </div>
        {% endfor %}
        {% if section.settings.enable_zoom %}<button class="tss-gallery__zoom" type="button" aria-label="Zoom current product image" data-gallery-zoom><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 5 5M10.8 7.5v6.6M7.5 10.8h6.6"/></svg></button>{% endif %}
        {% if section.settings.show_arrows and media_count > 1 %}
          <button type="button" class="tss-gallery__arrow tss-gallery__arrow--prev" data-gallery-prev aria-label="Previous product media"><span aria-hidden="true">‹</span></button>
          <button type="button" class="tss-gallery__arrow tss-gallery__arrow--next" data-gallery-next aria-label="Next product media"><span aria-hidden="true">›</span></button>
        {% endif %}
        {% if section.settings.show_counter %}<div class="tss-gallery__counter" aria-live="polite"><span data-gallery-current>{{ initial_media.position | default: 1 }}</span> / {{ media_count }}</div>{% endif %}
      </div>
    {% else %}
      <div class="tss-gallery__empty">{{ 'product-1' | placeholder_svg_tag }}<p>No product media available</p></div>
    {% endif %}
  </div>
  {% if section.settings.enable_zoom and media_count > 0 %}
    <dialog class="tss-gallery__dialog" aria-label="Product image zoom">
      <button type="button" class="tss-gallery__dialog-close" data-gallery-close aria-label="Close zoom">×</button>
      <img class="tss-gallery__dialog-image" alt="" width="1600" height="1600" data-gallery-zoom-image>
    </dialog>
  {% endif %}
</section>

<style>
  #PremiumGallery-{{ section.id }}{width:100%;background:var(--tss-bg);color:#292723;font-family:inherit}
  #PremiumGallery-{{ section.id }} *{box-sizing:border-box}
  #PremiumGallery-{{ section.id }} button{font:inherit;cursor:pointer}
  #PremiumGallery-{{ section.id }} button:focus-visible,#PremiumGallery-{{ section.id }} .tss-gallery__main:focus-visible{outline:2px solid #3c3934;outline-offset:3px}
  #PremiumGallery-{{ section.id }} .tss-gallery__layout{display:grid;grid-template-columns:var(--tss-thumb) minmax(0,1fr);gap:var(--tss-gap);max-width:100%;align-items:start}
  #PremiumGallery-{{ section.id }} .tss-gallery__layout--right{grid-template-columns:minmax(0,1fr) var(--tss-thumb)}
  #PremiumGallery-{{ section.id }} .tss-gallery__layout--right .tss-gallery__thumbs{grid-column:2;grid-row:1}
  #PremiumGallery-{{ section.id }} .tss-gallery__layout--right .tss-gallery__main{grid-column:1;grid-row:1}
  #PremiumGallery-{{ section.id }} .tss-gallery__layout--no-thumbs{grid-template-columns:minmax(0,1fr)}
  #PremiumGallery-{{ section.id }} .tss-gallery__thumbs{display:flex;flex-direction:column;gap:10px;max-height:700px;overflow:auto;scrollbar-width:thin;padding:3px}
  #PremiumGallery-{{ section.id }} .tss-gallery__thumb{position:relative;display:block;width:100%;aspect-ratio:1;border:1px solid #dedbd5;background:#f5f3f0;border-radius:calc(var(--tss-radius) * .55);overflow:hidden;padding:0;opacity:.65;transition:opacity .2s,border-color .2s,box-shadow .2s;flex-shrink:0}
  #PremiumGallery-{{ section.id }} .tss-gallery__thumb.is-active{opacity:1;border-color:#39342f;box-shadow:0 0 0 1px #39342f}
  #PremiumGallery-{{ section.id }} .tss-gallery__thumb img,#PremiumGallery-{{ section.id }} .tss-gallery__thumb svg{width:100%;height:100%;object-fit:cover;display:block}
  #PremiumGallery-{{ section.id }} .tss-gallery__media-badge{position:absolute;right:5px;bottom:5px;background:#fff;border-radius:4px;padding:2px 5px;font-size:10px}
  #PremiumGallery-{{ section.id }} .tss-gallery__main{position:relative;min-width:0;aspect-ratio:var(--tss-ratio);background:#f7f6f3;border-radius:var(--tss-radius);overflow:hidden;isolation:isolate}
  #PremiumGallery-{{ section.id }} .tss-gallery__slide{width:100%;height:100%;min-height:0}
  #PremiumGallery-{{ section.id }} .tss-gallery__slide[hidden]{display:none!important}
  #PremiumGallery-{{ section.id }} .tss-gallery__image,#PremiumGallery-{{ section.id }} .tss-gallery__video,#PremiumGallery-{{ section.id }} .tss-gallery__model,#PremiumGallery-{{ section.id }} .tss-gallery__slide iframe{width:100%;height:100%;display:block;object-fit:contain;border:0}
  #PremiumGallery-{{ section.id }} .tss-gallery__zoom,#PremiumGallery-{{ section.id }} .tss-gallery__arrow{position:absolute;z-index:2;display:grid;place-items:center;width:42px;height:42px;border-radius:50%;border:1px solid #e8e4de;background:rgba(255,255,255,.94);color:#292723;box-shadow:0 2px 12px #0000000c;transition:transform .2s,background .2s}
  #PremiumGallery-{{ section.id }} .tss-gallery__zoom:hover,#PremiumGallery-{{ section.id }} .tss-gallery__arrow:hover{background:#fff;transform:scale(1.06)}
  #PremiumGallery-{{ section.id }} .tss-gallery__zoom{top:16px;right:16px}
  #PremiumGallery-{{ section.id }} .tss-gallery__zoom svg{width:21px;height:21px}
  #PremiumGallery-{{ section.id }} .tss-gallery__arrow{top:50%;transform:translateY(-50%)}
  #PremiumGallery-{{ section.id }} .tss-gallery__arrow:hover{transform:translateY(-50%) scale(1.06)}
  #PremiumGallery-{{ section.id }} .tss-gallery__arrow--prev{left:14px}
  #PremiumGallery-{{ section.id }} .tss-gallery__arrow--next{right:14px}
  #PremiumGallery-{{ section.id }} .tss-gallery__arrow span{font-size:31px;line-height:1;margin-top:-4px}
  #PremiumGallery-{{ section.id }} .tss-gallery__counter{position:absolute;bottom:14px;left:50%;transform:translateX(-50%);z-index:2;background:#ffffffed;border-radius:30px;padding:7px 14px;font-size:12px;letter-spacing:.08em}
  #PremiumGallery-{{ section.id }} .tss-gallery__empty{min-height:300px;display:grid;place-items:center;background:#f7f6f3;border-radius:var(--tss-radius);padding:30px;text-align:center}
  #PremiumGallery-{{ section.id }} .tss-gallery__empty svg{width:200px;max-width:100%}
  #PremiumGallery-{{ section.id }} .tss-gallery__dialog{position:fixed;inset:0;width:100vw;max-width:none;height:100dvh;max-height:none;margin:0;padding:45px 20px 20px;border:0;background:#f9f8f6;overflow:auto}
  #PremiumGallery-{{ section.id }} .tss-gallery__dialog::backdrop{background:#000b}
  #PremiumGallery-{{ section.id }} .tss-gallery__dialog-image{display:block;width:100%;height:100%;object-fit:contain}
  #PremiumGallery-{{ section.id }} .tss-gallery__dialog-close{position:fixed;top:16px;right:22px;z-index:3;width:42px;height:42px;border-radius:50%;border:1px solid #ddd;background:white;color:#222;font-size:30px;line-height:1}
  @media(max-width:749px){
    #PremiumGallery-{{ section.id }} .tss-gallery__layout,#PremiumGallery-{{ section.id }} .tss-gallery__layout--right{display:flex;flex-direction:column;gap:12px}
    #PremiumGallery-{{ section.id }} .tss-gallery__main{width:100%;order:0}
    #PremiumGallery-{{ section.id }} .tss-gallery__thumbs{width:100%;max-height:none;flex-direction:row;overflow-x:auto;order:1;gap:9px;padding:3px 3px 8px;scroll-snap-type:x proximity}
    #PremiumGallery-{{ section.id }} .tss-gallery__thumb{width:68px;flex:0 0 68px;scroll-snap-align:start}
    #PremiumGallery-{{ section.id }} .tss-gallery__zoom,#PremiumGallery-{{ section.id }} .tss-gallery__arrow{width:36px;height:36px}
    #PremiumGallery-{{ section.id }} .tss-gallery__zoom{top:10px;right:10px}
    #PremiumGallery-{{ section.id }} .tss-gallery__arrow--prev{left:8px}
    #PremiumGallery-{{ section.id }} .tss-gallery__arrow--next{right:8px}
  }
  @media(prefers-reduced-motion:reduce){#PremiumGallery-{{ section.id }} *,#PremiumGallery-{{ section.id }} *::before,#PremiumGallery-{{ section.id }} *::after{transition:none!important;scroll-behavior:auto!important}}
</style>

<script>
(() => {
  const rootId = 'PremiumGallery-{{ section.id }}';
  const initialize = () => {
    const root = document.getElementById(rootId);
    if (!root || root.dataset.galleryInitialized === 'true') return;
    root.dataset.galleryInitialized = 'true';
    const slides = Array.from(root.querySelectorAll('.tss-gallery__slide'));
    const thumbs = Array.from(root.querySelectorAll('.tss-gallery__thumb'));
    const main = root.querySelector('.tss-gallery__main');
    const currentLabel = root.querySelector('[data-gallery-current]');
    const dialog = root.querySelector('.tss-gallery__dialog');
    const zoomImage = root.querySelector('[data-gallery-zoom-image]');
    let index = Math.max(0, slides.findIndex(slide => slide.classList.contains('is-active')));
    let pointerStartX = null;
    const show = (nextIndex, focusThumb = false) => {
      if (!slides.length) return;
      index = (nextIndex + slides.length) % slides.length;
      slides.forEach((slide, i) => {
        const active = i === index;
        slide.hidden = !active;
        slide.classList.toggle('is-active', active);
        if (!active) slide.querySelectorAll('video').forEach(video => video.pause());
        if (!active) slide.querySelectorAll('iframe').forEach(frame => {
          // Remove inactive embeds to stop playback; restore on reactivation.
          if (!frame.dataset.gallerySrc && frame.src) frame.dataset.gallerySrc = frame.src;
          if (frame.src) frame.removeAttribute('src');
        });
        if (active) slide.querySelectorAll('iframe[data-gallery-src]').forEach(frame => {
          if (!frame.getAttribute('src')) frame.src = frame.dataset.gallerySrc;
        });
      });
      thumbs.forEach((thumb, i) => {
        const active = i === index;
        thumb.classList.toggle('is-active', active);
        thumb.setAttribute('aria-pressed', String(active));
      });
      if (currentLabel) currentLabel.textContent = String(index + 1);
      if (thumbs[index]) {
        thumbs[index].scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });
        if (focusThumb) thumbs[index].focus({ preventScroll: true });
      }
      const imageSlide = slides[index].dataset.mediaType === 'image';
      const zoomButton = root.querySelector('[data-gallery-zoom]');
      if (zoomButton) { zoomButton.hidden = !imageSlide; zoomButton.disabled = !imageSlide; }
    };
    const goToMediaId = id => {
      if (!id) return false;
      const found = slides.findIndex(slide => slide.dataset.mediaId === String(id));
      if (found < 0) return false;
      show(found);
      return true;
    };
    const onClick = event => {
      const thumb = event.target.closest('.tss-gallery__thumb');
      if (thumb && root.contains(thumb)) { show(Number(thumb.dataset.index)); return; }
      if (event.target.closest('[data-gallery-prev]')) { show(index - 1); return; }
      if (event.target.closest('[data-gallery-next]')) { show(index + 1); return; }
      if (event.target.closest('[data-gallery-close]')) { dialog?.close(); return; }
      if (event.target.closest('[data-gallery-zoom]') && dialog && zoomImage) {
        const active = slides[index];
        const image = active?.querySelector('img');
        if (!image || active.dataset.mediaType !== 'image') return;
        zoomImage.src = image.currentSrc || image.src;
        zoomImage.alt = image.alt || 'Product image';
        dialog.showModal();
      }
    };
    root.addEventListener('click', onClick);
    main?.addEventListener('keydown', event => {
      if (event.target !== main) return;
      if (event.key === 'ArrowLeft') { event.preventDefault(); show(index - 1); }
      if (event.key === 'ArrowRight') { event.preventDefault(); show(index + 1); }
    });
    main?.addEventListener('pointerdown', event => { if (event.pointerType === 'touch') pointerStartX = event.clientX; });
    main?.addEventListener('pointerup', event => {
      if (pointerStartX === null || event.pointerType !== 'touch') return;
      const delta = event.clientX - pointerStartX;
      pointerStartX = null;
      if (Math.abs(delta) > 55 && !event.target.closest('video,iframe,model-viewer')) show(index + (delta < 0 ? 1 : -1));
    });
    dialog?.addEventListener('click', event => { if (event.target === dialog) dialog.close(); });
    const onVariant = event => {
      // Different themes emit different payloads. These are optional adapters,
      // not a substitute for integrating the theme's actual variant convention.
      const variant = event.detail?.variant || event.detail?.selectedVariant || event.detail?.resource;
      const mediaId = variant?.featured_media?.id || variant?.featuredMedia?.id || event.detail?.mediaId;
      if (mediaId) goToMediaId(mediaId);
    };
    ['variant:change', 'variant:changed', 'product:variant-change'].forEach(name => document.addEventListener(name, onVariant));
    // Native Shopify product form variant ID changes are often silent; no reliable
    // universal listener exists. Integrate your theme's own variant callback if needed.
    const cleanup = event => {
      if (event.detail?.sectionId !== '{{ section.id }}') return;
      ['variant:change', 'variant:changed', 'product:variant-change'].forEach(name => document.removeEventListener(name, onVariant));
      document.removeEventListener('shopify:section:unload', cleanup);
      root.dataset.galleryInitialized = 'false';
    };
    document.addEventListener('shopify:section:unload', cleanup);
    show(index);
  };
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initialize, { once: true });
  else initialize();
  document.addEventListener('shopify:section:load', event => {
    if (event.detail?.sectionId === '{{ section.id }}') initialize();
  });
})();
</script>

{% schema %}
{
  "name": "Premium product gallery",
  "tag": "section",
  "class": "section-premium-product-gallery",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "checkbox", "id": "show_thumbs", "label": "Show thumbnails", "default": true },
    { "type": "select", "id": "thumb_position", "label": "Desktop thumbnail position", "options": [{ "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }], "default": "left" },
    { "type": "range", "id": "thumb_width", "label": "Desktop thumbnail width", "min": 56, "max": 140, "step": 4, "unit": "px", "default": 88 },
    { "type": "select", "id": "ratio", "label": "Main media aspect ratio", "options": [{ "value": "square", "label": "Square" }, { "value": "portrait", "label": "Portrait" }, { "value": "landscape", "label": "Landscape" }], "default": "portrait" },
    { "type": "range", "id": "radius", "label": "Corner radius", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 12 },
    { "type": "range", "id": "spacing", "label": "Gallery spacing", "min": 4, "max": 32, "step": 2, "unit": "px", "default": 16 },
    { "type": "checkbox", "id": "show_arrows", "label": "Show navigation arrows", "default": true },
    { "type": "checkbox", "id": "enable_zoom", "label": "Enable image zoom", "default": true },
    { "type": "checkbox", "id": "show_counter", "label": "Show media counter", "default": true },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" }
  ],
  "presets": [{ "name": "Premium product gallery" }]
}
{% endschema %}
