{% stylesheet %}
/* ================= SECTION ================= */
.tss-category-rings {
  background: var(--tss-bg);
  padding: var(--tss-padding-top) 20px var(--tss-padding-bottom);
  text-align: center;
}

/* HEADING */
.tss-category-rings__heading {
  font-size: clamp(28px,4vw,42px);
  font-weight: 800;
  color: #5A0F2E;
  letter-spacing: 2px;
  margin-bottom: var(--tss-heading-gap);
}

/* ================= WRAPPER ================= */
.tss-category-rings__grid-wrapper {
  position: relative;
  max-width: var(--tss-max-width);
  margin: 0 auto;
}

/* ================= GRID ================= */
.tss-category-rings__grid {
  display:flex;
  justify-content:center;
  overflow-x:auto;
  scroll-behavior:smooth;
  gap:40px;
}

/* ================= ITEMS ================= */
.tss-category-rings__item {
  display:flex;
  flex-direction:column;
  align-items:center;
  flex-shrink:0;
}

.tss-category-rings__item a {
  display:flex;
  flex-direction:column;
  align-items:center;
  text-decoration:none;
  color:inherit;
}

/* ================= SQUARE SYSTEM ================= */
.tss-ring-wrapper {
  position:relative;
  width:calc(190px * var(--tss-scale));
  height:calc(190px * var(--tss-scale));
  display:flex;
  align-items:center;
  justify-content:center;
}

.tss-ring-outer,
.tss-ring-inner {
  position:absolute;
  border-radius:22px;
  opacity:0;
  transform:scale(0.9);
  transition:all 0.6s ease;
}

.tss-ring-outer {
  width:100%;
  height:100%;
  border:6px solid var(--tss-ring-outer);
}

.tss-ring-inner {
  width:82%;
  height:82%;
  border:4px solid var(--tss-ring-inner);
}

/* DOT */
.tss-ring-dot {
  position:absolute;
  top:8%;
  right:8%;
  width:12px;
  height:12px;
  background:var(--tss-dot);
  border-radius:50%;
  opacity:0;
  transition:opacity 0.4s ease;
}

/* IMAGE */
.tss-category-image {
  width:85%;
  height:85%;
  border-radius:18px;
  overflow:hidden;
  background:#fff;
  z-index:3;
  border:2px solid var(--tss-ring-inner);
  box-shadow:0 12px 25px rgba(90,15,46,0.15);
  transition:transform 0.4s ease, box-shadow 0.4s ease;
}

.tss-category-image img {
  width:100%;
  height:100%;
  object-fit:cover;
}

/* ================= HOVER ================= */
.tss-category-rings__item:hover .tss-ring-outer {
  opacity:1;
  transform:scale(1) rotate(360deg);
}

.tss-category-rings__item:hover .tss-ring-inner {
  opacity:1;
  transform:scale(1) rotate(-360deg);
}

.tss-category-rings__item:hover .tss-ring-dot {
  opacity:1;
}

.tss-category-rings__item:hover .tss-category-image {
  transform:translateY(-8px);
  box-shadow:0 28px 45px rgba(90,15,46,0.3);
}

.tss-category-rings__item:hover .tss-category-title {
  color:#AD1457;
}

/* TITLE */
.tss-category-title {
  margin-top:22px;
  font-size:18px;
  font-weight:600;
  color:#6B1B3A;
  transition:color 0.3s ease;
}

/* ================= NAV SIDE ================= */
.tss-slider-nav {
  position: absolute;
  top: 50%;
  left: 0;
  width: 100%;
  transform: translateY(-50%);
  display: flex;
  justify-content: space-between;
  pointer-events: none;
  z-index: 10;
}

.tss-slider-nav button {
  pointer-events: all;
  width: 48px;
  height: 48px;
  border: none;
  border-radius: 50%;
  cursor: pointer;
  font-size: 18px;
  background: #fff;
  box-shadow: 0 10px 25px rgba(0,0,0,0.2);
  transition: 0.3s ease;
}

.tss-prev {
  transform: translateX(-70%);
}

.tss-next {
  transform: translateX(70%);
}

.tss-slider-nav button:hover {
  transform: scale(1.1);
}

/* ================= MOBILE ================= */
@media (max-width:768px){

  .tss-category-rings{
    padding-left:12px;
    padding-right:12px;
  }

  .tss-category-rings__heading{
    font-size:24px;
  }

  .tss-category-rings__grid{
    justify-content:flex-start;
    gap:18px;
    padding:0 20px;
    scrollbar-width:none;
  }

  .tss-category-rings__grid::-webkit-scrollbar{
    display:none;
  }

  .tss-ring-wrapper{
    width:180px;
    height:180px;
  }

  .tss-category-title{
    font-size:13px;
    margin-top:10px;
  }

  .tss-slider-nav{
    display:none;
  }
}
{% endstylesheet %}
<section
class="tss-category-rings"
style="
--tss-bg: {{ section.settings.bg_color }};
--tss-ring-outer: {{ section.settings.outer_ring_color }};
--tss-ring-inner: {{ section.settings.inner_ring_color }};
--tss-dot: {{ section.settings.dot_color }};
--tss-max-width: {{ section.settings.section_max_width }}px;
--tss-padding-top: {{ section.settings.padding_top }}px;
--tss-padding-bottom: {{ section.settings.padding_bottom }}px;
--tss-scale: {{ section.settings.square_scale | divided_by: 100.0 }};
--tss-heading-gap: {{ section.settings.heading_gap }}px;
"
>

{% if section.settings.heading != blank %}
<h2 class="tss-category-rings__heading">
{{ section.settings.heading }}
</h2>
{% endif %}

<div class="tss-category-rings__grid-wrapper">

  <div class="tss-slider-nav">
    <button class="tss-prev">←</button>
    <button class="tss-next">→</button>
  </div>

  <div class="tss-category-rings__grid">

  {% for block in section.blocks %}
  {% if block.settings.collection %}

  <div class="tss-category-rings__item" {{ block.shopify_attributes }}>

  <a href="{{ block.settings.collection.url }}">

  <div class="tss-ring-wrapper">
    <div class="tss-ring-outer"></div>
    <div class="tss-ring-inner"></div>
    <div class="tss-ring-dot"></div>

    <div class="tss-category-image">
      {% if block.settings.collection.image %}
      <img src="{{ block.settings.collection.image | img_url: '400x400' }}" alt="{{ block.settings.collection.title }}" loading="lazy">
      {% elsif block.settings.collection.products.first.featured_image %}
      <img src="{{ block.settings.collection.products.first.featured_image | img_url: '400x400' }}" alt="{{ block.settings.collection.title }}" loading="lazy">
      {% endif %}
    </div>
  </div>

  <div class="tss-category-title">
  {{ block.settings.collection.title }}
  </div>

  </a>

  </div>

  {% endif %}
  {% endfor %}

  </div>
</div>

</section>

<script>
document.addEventListener("DOMContentLoaded", function () {
  document.querySelectorAll(".tss-category-rings").forEach(section => {
    const slider = section.querySelector(".tss-category-rings__grid");
    const prev = section.querySelector(".tss-prev");
    const next = section.querySelector(".tss-next");

    if (prev && next && slider) {
      prev.addEventListener("click", () => {
        slider.scrollBy({ left: -220, behavior: "smooth" });
      });

      next.addEventListener("click", () => {
        slider.scrollBy({ left: 220, behavior: "smooth" });
      });
    }
  });
});
</script>
{% schema %}
{
"name": "TSS – Category Squares",
"settings": [
{ "type": "text", "id": "heading", "label": "Heading", "default": "SHOP BY CATEGORY" },
{ "type": "color", "id": "bg_color", "label": "Background Color", "default": "#fdeee8" },
{ "type": "color", "id": "outer_ring_color", "label": "Outer Border Color", "default": "#3aa17e" },
