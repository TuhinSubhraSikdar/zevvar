
{% comment %}
  ZEVVAR Animated Jewellery Benefits
  Features:
  - Shopify CDN image picker
  - Animated icon colours and hover effects
  - Descriptions appear on desktop hover
  - Descriptions toggle on mobile tap
  - Accessible controls and reduced-motion support
{% endcomment %}

<section
  id="zevvar-benefits-{{ section.id }}"
  class="zevvar-benefits"
  style="
    --zb-bg: {{ section.settings.background }};
    --zb-text: {{ section.settings.text_color }};
    --zb-hover: {{ section.settings.hover_color }};
    --zb-speed: {{ section.settings.animation_speed }}s;
    --zb-icon-size: {{ section.settings.icon_size }}px;
    --zb-gap: {{ section.settings.column_gap }}px;
  "
>
  <div class="zb-inner">

    {% if section.settings.heading != blank %}
      <h2 class="zb-heading">
        {{ section.settings.heading | escape }}
      </h2>
    {% endif %}

    <div class="zb-grid">
      {% for block in section.blocks %}
        <div
          class="zb-item"
          style="--zb-delay: {{ forloop.index0 | times: 0.18 }}s;"
          {{ block.shopify_attributes }}
        >
          <div class="zb-icon-wrap">
            {% if block.settings.icon != blank %}
              <img
                class="zb-icon"
                src="{{ block.settings.icon | image_url: width: 300 }}"
                alt="{{ block.settings.label | escape }}"
                width="{{ section.settings.icon_size }}"
                height="{{ section.settings.icon_size }}"
                loading="lazy"
              >
            {% else %}
              <div class="zb-placeholder" aria-hidden="true">
                <span>+</span>
              </div>
            {% endif %}
          </div>

          {% if block.settings.label != blank %}
            <p class="zb-label">
              {{ block.settings.label | escape }}
            </p>
          {% endif %}

          {% if block.settings.description != blank %}
            <button
              type="button"
              class="zb-description-toggle"
              aria-expanded="false"
              aria-label="Show details for {{ block.settings.label | escape }}"
              aria-controls="zb-description-{{ section.id }}-{{ block.id }}"
            >
              <span class="zb-toggle-icon" aria-hidden="true">+</span>
            </button>

            <div
              class="zb-description"
              id="zb-description-{{ section.id }}-{{ block.id }}"
              hidden
            >
              {{ block.settings.description | escape }}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>

  </div>
</section>

<style>
  #zevvar-benefits-{{ section.id }} {
    background: var(--zb-bg);
    color: var(--zb-text);
    padding: {{ section.settings.padding_y }}px 20px;
    overflow: hidden;
  }

  #zevvar-benefits-{{ section.id }} *,
  #zevvar-benefits-{{ section.id }} *::before,
  #zevvar-benefits-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #zevvar-benefits-{{ section.id }} .zb-inner {
    width: 100%;
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }

  #zevvar-benefits-{{ section.id }} .zb-heading {
    color: var(--zb-text);
    text-align: center;
    font-size: clamp(22px, 3vw, 32px);
    line-height: 1.3;
    margin: 0 0 30px;
  }

  #zevvar-benefits-{{ section.id }} .zb-grid {
    display: grid;
    grid-template-columns:
      repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr));
    gap: var(--zb-gap);
    align-items: start;
  }

  #zevvar-benefits-{{ section.id }} .zb-item {
    min-width: 0;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 12px 8px;
    border-radius: 14px;
    transition:
      background-color 0.35s ease,
      transform 0.35s ease;
    animation: zb-enter-{{ section.id }} 0.7s both;
    animation-delay: var(--zb-delay);
  }

  #zevvar-benefits-{{ section.id }} .zb-icon-wrap {
    width: var(--zb-icon-size);
    height: var(--zb-icon-size);
    max-width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 10px;
    transition: transform 0.4s ease;
  }

  #zevvar-benefits-{{ section.id }} .zb-icon {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transform-origin: center;
    animation: zb-colour-{{ section.id }} var(--zb-speed) ease-in-out infinite alternate;
    animation-delay: var(--zb-delay);
    transition:
      transform 0.4s ease,
      filter 0.4s ease;
  }

  #zevvar-benefits-{{ section.id }} .zb-placeholder {
    width: 65%;
    height: 65%;
    display: grid;
    place-items: center;
    border: 2px solid var(--zb-text);
    border-radius: 50%;
    font-size: 28px;
  }

  #zevvar-benefits-{{ section.id }} .zb-label {
    color: var(--zb-text);
    font-size: {{ section.settings.label_size }}px;
    line-height: 1.4;
    font-weight: 600;
    margin: 0;
    transition: color 0.3s ease;
  }

  /* Description toggle button */
  #zevvar-benefits-{{ section.id }} .zb-description-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 27px;
    height: 27px;
    min-height: 27px;
    flex-shrink: 0;
    padding: 0;
    margin: 8px 0 0;
    border: 1px solid var(--zb-text);
    border-radius: 50%;
    background: transparent;
    color: var(--zb-text);
    font: inherit;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition:
      background-color 0.25s ease,
      color 0.25s ease,
      border-color 0.25s ease;
  }

  #zevvar-benefits-{{ section.id }} .zb-toggle-icon {
    display: block;
    font-size: 20px;
    line-height: 1;
    transition: transform 0.25s ease;
  }

  #zevvar-benefits-{{ section.id }} .zb-description-toggle[aria-expanded="true"] {
    background: var(--zb-text);
    color: var(--zb-bg);
    border-color: var(--zb-text);
  }

  #zevvar-benefits-{{ section.id }} .zb-description-toggle[aria-expanded="true"] .zb-toggle-icon {
    transform: rotate(45deg);
  }

  #zevvar-benefits-{{ section.id }} .zb-description-toggle:focus-visible {
    outline: 2px solid var(--zb-hover);
    outline-offset: 4px;
  }

  /* Hidden by default */
  #zevvar-benefits-{{ section.id }} .zb-description[hidden] {
    display: none !important;
  }

  #zevvar-benefits-{{ section.id }} .zb-description {
    display: block;
    width: 100%;
    max-width: 260px;
    margin: 10px auto 0;
    color: var(--zb-text);
    font-size: 13px;
    line-height: 1.65;
    overflow-wrap: anywhere;
    animation: zb-description-in-{{ section.id }} 0.3s ease both;
  }

  /* Desktop: show description on hover */
  @media (hover: hover) and (pointer: fine) {
    #zevvar-benefits-{{ section.id }} .zb-item:hover {
      background: rgba(185, 152, 72, 0.07);
      transform: translateY(-3px);
    }

    #zevvar-benefits-{{ section.id }} .zb-item:hover .zb-icon {
      animation-play-state: paused;
      transform: translateY(-4px) scale(1.08);
      filter: hue-rotate(-18deg) saturate(1.4) brightness(1.03);
    }

    #zevvar-benefits-{{ section.id }} .zb-item:hover .zb-label {
      color: var(--zb-hover);
    }

    #zevvar-benefits-{{ section.id }} .zb-item:hover .zb-description-toggle {
      background: var(--zb-text);
      color: var(--zb-bg);
    }

    #zevvar-benefits-{{ section.id }} .zb-item:hover .zb-description-toggle .zb-toggle-icon {
      transform: rotate(45deg);
    }

    #zevvar-benefits-{{ section.id }} .zb-item:hover .zb-description {
      display: block;
    }
  }

  /* Open state: useful for touch screens and keyboard users */
  #zevvar-benefits-{{ section.id }} .zb-item.zb-open .zb-description {
    display: block;
  }

  #zevvar-benefits-{{ section.id }} .zb-item.zb-open .zb-label {
    color: var(--zb-hover);
  }

  /* Icon colour and movement */
  @keyframes zb-colour-{{ section.id }} {
    0% {
      filter: hue-rotate(0deg) saturate(1);
      transform: translateY(0);
    }

    50% {
      filter: hue-rotate(-15deg) saturate(1.2);
      transform: translateY(-3px);
    }

    100% {
      filter: hue-rotate(12deg) saturate(1.1);
      transform: translateY(0);
    }
  }

  @keyframes zb-enter-{{ section.id }} {
    from {
      opacity: 0;
      transform: translateY(12px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes zb-description-in-{{ section.id }} {
    from {
      opacity: 0;
      transform: translateY(6px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Mobile layout */
  @media (max-width: 749px) {
    #zevvar-benefits-{{ section.id }} {
      padding-left: 14px;
      padding-right: 14px;
    }

    #zevvar-benefits-{{ section.id }} .zb-grid {
      grid-template-columns:
        repeat({{ section.settings.columns_mobile }}, minmax(0, 1fr));
      gap: 14px 10px;
    }

    #zevvar-benefits-{{ section.id }} .zb-item {
      padding: 10px 4px;
    }

    #zevvar-benefits-{{ section.id }} .zb-icon-wrap {
      width: min(var(--zb-icon-size), 64px);
      height: min(var(--zb-icon-size), 64px);
      margin-bottom: 8px;
    }

    #zevvar-benefits-{{ section.id }} .zb-label {
      font-size: {{ section.settings.mobile_label_size }}px;
    }

    #zevvar-benefits-{{ section.id }} .zb-description {
      font-size: 12px;
      max-width: 220px;
    }

    /* Touch users reveal details through the plus button */
    #zevvar-benefits-{{ section.id }} .zb-item:hover {
      background: transparent;
      transform: none;
    }

    #zevvar-benefits-{{ section.id }} .zb-item:hover .zb-icon {
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #zevvar-benefits-{{ section.id }} .zb-item,
    #zevvar-benefits-{{ section.id }} .zb-icon,
    #zevvar-benefits-{{ section.id }} .zb-description,
    #zevvar-benefits-{{ section.id }} .zb-description-toggle,
    #zevvar-benefits-{{ section.id }} .zb-toggle-icon,
    #zevvar-benefits-{{ section.id }} .zb-label {
      animation: none !important;
      transition: none !important;
    }

    #zevvar-benefits-{{ section.id }} .zb-item:hover .zb-icon {
      transform: none;
    }
  }
</style>

<script>
  (() => {
    const section = document.getElementById(
      'zevvar-benefits-{{ section.id }}'
    );

    if (!section || section.dataset.zbInitialized === 'true') return;

    section.dataset.zbInitialized = 'true';

    const buttons = section.querySelectorAll('.zb-description-toggle');

    function closeItem(item) {
      item.classList.remove('zb-open');

      const button = item.querySelector('.zb-description-toggle');
      const description = item.querySelector('.zb-description');

      if (button) {
        button.setAttribute('aria-expanded', 'false');
        button.setAttribute(
          'aria-label',
          'Show details for ' +
            (item.querySelector('.zb-label')?.textContent.trim() || 'benefit')
        );
      }

      if (description) {
        description.hidden = true;
      }
    }

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const item = button.closest('.zb-item');
        if (!item) return;

        const wasOpen = item.classList.contains('zb-open');

        section.querySelectorAll('.zb-item.zb-open').forEach(closeItem);

        if (!wasOpen) {
          item.classList.add('zb-open');
          button.setAttribute('aria-expanded', 'true');
          button.setAttribute(
            'aria-label',
            'Hide details for ' +
              (item.querySelector('.zb-label')?.textContent.trim() || 'benefit')
          );

          const description = item.querySelector('.zb-description');

          if (description) {
            description.hidden = false;
          }
        }
      });
    });

    /* Close an open popup when clicking outside the section */
    document.addEventListener('click', (event) => {
      if (!section.contains(event.target)) {
        section.querySelectorAll('.zb-item.zb-open').forEach(closeItem);
      }
    });

    /* Support Shopify Theme Editor section reloads */
    document.addEventListener('shopify:section:unload', (event) => {
      if (event.detail && event.detail.sectionId === '{{ section.id }}') {
        section.dataset.zbInitialized = 'false';
      }
    });
  })();
</script>

{% schema %}
{
  "name": "ZEVVAR benefit icons",
  "tag": "section",
  "class": "section-zevvar-benefits",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Choose ZEVVAR"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background colour",
      "default": "#F7F3E9"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Icon and text colour",
      "default": "#879400"
    },
    {
      "type": "color",
      "id": "hover_color",
      "label": "Hover accent colour",
      "default": "#B99848"
    },
    {
      "type": "range",
      "id": "animation_speed",
      "label": "Colour animation duration",
      "min": 2,
      "max": 12,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 40,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 75
    },
    {
      "type": "range",
      "id": "label_size",
      "label": "Desktop label size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
