      "id": "max_width",
      "label": "Maximum content width",
      "min": 600,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "default": 1200
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit icon",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Choose icon image"
        },
