
{% liquid
  assign intro_width = section.settings.intro_width
%}

<section
  id="zevvar-showcase-{{ section.id }}"
  class="zevvar-showcase"
  style="
    --zv-burgundy: {{ section.settings.background_color }};
    --zv-gold: {{ section.settings.gold_color }};
    --zv-text: {{ section.settings.text_color }};
    --zv-card-title: {{ section.settings.card_text_color }};
    --zv-gap: {{ section.settings.card_gap }}px;
  "
>
  <div class="zevvar-showcase__grid">

    <!-- Introduction panel -->
    <div class="zevvar-showcase__intro">
      <div class="zevvar-showcase__intro-content">
        {% if section.settings.eyebrow != blank %}
          <p class="zevvar-showcase__eyebrow">
            {{ section.settings.eyebrow | escape }}
          </p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="zevvar-showcase__heading">
            {{ section.settings.heading | escape | newline_to_br }}
          </h2>
        {% endif %}

        {% if section.settings.description != blank %}
          <div class="zevvar-showcase__description">
            {{ section.settings.description }}
          </div>
        {% endif %}

        {% if section.settings.show_button %}
          {% assign button_link = section.settings.button_link %}
          {% if button_link == blank %}
            {% assign button_link = routes.all_products_collection_url %}
          {% endif %}

          <a
            class="zevvar-showcase__button"
            href="{{ button_link }}"
          >
            <span>{{ section.settings.button_label | escape }}</span>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M4 12h15M13 5l7 7-7 7"
                fill="none" stroke="currentColor"
                stroke-width="1.7" stroke-linecap="round"
                stroke-linejoin="round"/>
            </svg>
          </a>
        {% endif %}
      </div>

      <!-- Animated gold botanical ornament -->
      {% if section.settings.show_ornament %}
        <svg
          class="zevvar-showcase__ornament"
          viewBox="0 0 220 250"
          fill="none"
          aria-hidden="true"
        >
          <g stroke="currentColor" stroke-width="1.35"
             stroke-linecap="round" stroke-linejoin="round">
            <path d="M35 235C65 192 93 152 116 109S163 36 205 8"/>
            <path d="M75 180C43 173 24 150 19 124C45 131 67 151 75 180Z"/>
            <path d="M90 154C123 154 147 137 159 110C130 115 106 132 90 154Z"/>
            <path d="M111 115C79 107 63 86 60 60C86 73 105 91 111 115Z"/>
            <path d="M128 87C157 86 181 69 190 44C164 50 143 66 128 87Z"/>
            <path d="M146 57C132 34 137 15 151 2C164 24 161 42 146 57Z"/>
            <path d="M57 204C34 199 14 207 5 226C26 228 44 220 57 204Z"/>
            <path d="M77 181C96 190 111 208 113 230C92 219 80 202 77 181Z"/>
            <path d="M94 150C70 143 51 147 37 164C58 170 78 165 94 150Z"/>
            <path d="M160 106C176 110 196 103 207 87C188 82 171 91 160 106Z"/>
            <path d="M114 113C124 95 125 76 116 58C105 77 105 97 114 113Z"/>
            <path d="M176 41C185 25 184 13 176 2C165 15 166 29 176 41Z"/>
            <path d="M32 144C45 151 56 162 62 176"/>
            <path d="M128 137C141 126 151 116 159 110"/>
            <path d="M49 88C74 109 91 132 101 157"/>
          </g>
        </svg>
      {% endif %}
    </div>

    <!-- Collection cards -->
    {% for block in section.blocks %}
      {% assign collection = block.settings.collection %}
      {% assign card_image = block.settings.image %}

      {% if card_image == blank and collection != blank %}
        {% assign card_image = collection.featured_image %}
      {% endif %}

      {% assign card_title = block.settings.title %}
      {% if card_title == blank and collection != blank %}
        {% assign card_title = collection.title %}
      {% endif %}
      {% if card_title == blank %}
        {% assign card_title = 'Explore Collection' %}
      {% endif %}

      {% assign card_url = block.settings.custom_link %}
      {% if card_url == blank and collection != blank %}
        {% assign card_url = collection.url %}
      {% endif %}

      <a
        class="zevvar-showcase__card"
        href="{{ card_url | default: routes.all_products_collection_url }}"
        aria-label="{{ card_title | escape }}"
        {{ block.shopify_attributes }}
      >
        <div class="zevvar-showcase__image-wrap">
          {% if card_image != blank %}
            {{
              card_image
              | image_url: width: 1000
              | image_tag:
                class: 'zevvar-showcase__image',
                loading: 'lazy',
                widths: '320, 480, 640, 800, 1000',
                sizes: '(max-width: 749px) 50vw, 25vw',
                alt: card_title
            }}
          {% else %}
            {{ 'collection-1' | placeholder_svg_tag: 'zevvar-showcase__placeholder' }}
          {% endif %}

          <div class="zevvar-showcase__card-overlay"></div>

          <div class="zevvar-showcase__card-content">
            <h3 class="zevvar-showcase__card-title">
              {{ card_title | escape }}
            </h3>

            {% if section.settings.show_card_link %}
              <span class="zevvar-showcase__card-link">
                {{ section.settings.card_link_label | escape }}
                <span class="zevvar-showcase__card-arrow" aria-hidden="true">→</span>
              </span>
            {% endif %}
          </div>
        </div>
      </a>
    {% endfor %}

    {% if section.blocks.size == 0 %}
      <div class="zevvar-showcase__empty">
        Add collection blocks in the Theme Editor to get started.
      </div>
    {% endif %}

  </div>
</section>

<style>
  #zevvar-showcase-{{ section.id }} {
    width: 100%;
    overflow: hidden;
    background: var(--zv-burgundy);
  }

  #zevvar-showcase-{{ section.id }} *,
  #zevvar-showcase-{{ section.id }} *::before,
  #zevvar-showcase-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #zevvar-showcase-{{ section.id }} .zevvar-showcase__grid {
    display: grid;
    grid-template-columns:
      minmax(0, {{ intro_width }}fr)
      repeat({{ section.blocks.size }}, minmax(0, 1fr));
    gap: var(--zv-gap);
    min-height: {{ section.settings.desktop_height }}px;
  }

  #zevvar-showcase-{{ section.id }} .zevvar-showcase__intro {
    position: relative;
    display: flex;
    align-items: center;
    min-width: 0;
    overflow: hidden;
    padding: clamp(28px, 4.5vw, 76px);
    isolation: isolate;
    background: var(--zv-burgundy);
    color: var(--zv-text);
  }

  #zevvar-showcase-{{ section.id }} .zevvar-showcase__intro-content {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 490px;
  }

  #zevvar-showcase-{{ section.id }} .zevvar-showcase__eyebrow {
    margin: 0 0 12px;
    color: var(--zv-gold);
    font-size: clamp(13px, 1.1vw, 19px);
    line-height: 1.4;
    letter-spacing: .025em;
  }

  #zevvar-showcase-{{ section.id }} .zevvar-showcase__heading {
    margin: 0 0 18px;
    color: var(--zv-text);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(29px, 3vw, 54px);
    font-weight: 400;
    line-height: 1.04;
    letter-spacing: -.025em;
  }

  #zevvar-showcase-{{ section.id }} .zevvar-showcase__description {
    max-width: 410px;
    margin: 0;
    color: var(--zv-text);
    font-size: clamp(13px, 1vw, 16px);
    line-height: 1.6;
    opacity: .92;
  }

  #zevvar-showcase-{{ section.id }} .zevvar-showcase__description p {
    margin: 0;
  }

  #zevvar-showcase-{{ section.id }} .zevvar-showcase__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    margin-top: 25px;
    padding: 13px 23px;
    min-height: 44px;
    border-radius: 50px;
    background: #f8e8e7;
    color: #9e1647;
    text-decoration: none;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: .055em;
    text-transform: uppercase;
    transition: background .25s ease, transform .25s ease;
  }

  #zevvar-showcase-{{ section.id }} .zevvar-showcase__button:hover {
    background: #fff;
    transform: translateY(-2px);
  }

  #zevvar-showcase-{{ section.id }} .zevvar-showcase__button svg {
    width: 18px;
    height: 18px;
    flex: 0 0 18px;
  }

  /* The ornament pulses for a short time in each 4-second cycle. */
  #zevvar-showcase-{{ section.id }} .zevvar-showcase__ornament {
    position: absolute;
    z-index: 1;
    top: -5%;
    right: -3%;
    width: clamp(105px, 18vw, 250px);
    height: auto;
    color: var(--zv-gold);
    opacity: .62;
    pointer-events: none;
    animation: zevvarOrnamentGlow-{{ section.id }} 4s ease-in-out infinite;
  }

  @keyframes zevvarOrnamentGlow-{{ section.id }} {
    0%, 100% {
      opacity: .42;
      filter: drop-shadow(0 0 0 rgba(255, 220, 145, 0));
    }
    10% {
      opacity: .8;
      filter: drop-shadow(0 0 3px rgba(255, 220, 145, .5));
    }
    22% {
      opacity: 1;
      filter:
        drop-shadow(0 0 5px rgba(255, 220, 145, .9))
        drop-shadow(0 0 14px rgba(255, 196, 100, .45));
    }
    38% {
      opacity: .72;
      filter: drop-shadow(0 0 3px rgba(255, 220, 145, .35));
    }
    52%, 90% {
      opacity: .42;
      filter: drop-shadow(0 0 0 rgba(255, 220, 145, 0));
    }
  }

  #zevvar-showcase-{{ section.id }} .zevvar-showcase__card {
    position: relative;
    display: block;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    background: #e8d8c5;
    color: var(--zv-card-title);
    text-decoration: none;
    isolation: isolate;
  }

  #zevvar-showcase-{{ section.id }} .zevvar-showcase__image-wrap {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  #zevvar-showcase-{{ section.id }} .zevvar-showcase__image,
  #zevvar-showcase-{{ section.id }} .zevvar-showcase__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform .65s cubic-bezier(.2, .7, .2, 1);
  }

  #zevvar-showcase-{{ section.id }} .zevvar-showcase__card:hover .zevvar-showcase__image {
    transform: scale(1.045);
  }

  #zevvar-showcase-{{ section.id }} .zevvar-showcase__card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(24, 12, 12, .72) 0%,
      rgba(24, 12, 12, .28) 29%,
      rgba(24, 12, 12, 0) 64%
    );
    transition: background .3s ease;
  }

  #zevvar-showcase-{{ section.id }} .zevvar-showcase__card:hover .zevvar-showcase__card-overlay {
    background: linear-gradient(
      to top,
      rgba(24, 12, 12, .82) 0%,
      rgba(24, 12, 12, .32) 35%,
      rgba(24, 12, 12, .04) 75%
    );
  }

  #zevvar-showcase-{{ section.id }} .zevvar-showcase__card-content {
    position: absolute;
    z-index: 2;
    right: 14px;
    bottom: 20px;
    left: 14px;
    color: var(--zv-card-title);
  }

  #zevvar-showcase-{{ section.id }} .zevvar-showcase__card-title {
    margin: 0 0 9px;
    color: inherit;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(17px, 1.55vw, 27px);
    font-weight: 400;
    line-height: 1.15;
    text-shadow: 0 1px 8px rgba(0, 0, 0, .22);
  }

  #zevvar-showcase-{{ section.id }} .zevvar-showcase__card-link {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: inherit;
    font-size: 12px;
    line-height: 1.3;
  }

  #zevvar-showcase-{{ section.id }} .zevvar-showcase__card-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #b5004b;
    color: #fff;
    font-size: 16px;
    transition: transform .25s ease, background .25s ease;
  }

  #zevvar-showcase-{{ section.id }} .zevvar-showcase__card:hover .zevvar-showcase__card-arrow {
    transform: translateX(3px);
    background: #d4145a;
  }

  #zevvar-showcase-{{ section.id }} .zevvar-showcase__empty {
    padding: 35px;
    color: var(--zv-text);
    background: var(--zv-burgundy);
  }

  @media screen and (min-width: 750px) {
    #zevvar-showcase-{{ section.id }} .zevvar-showcase__grid {
      grid-template-columns:
        minmax(0, {{ intro_width }}fr)
        repeat({{ section.blocks.size }}, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    #zevvar-showcase-{{ section.id }} .zevvar-showcase__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 5px;
    }

    #zevvar-showcase-{{ section.id }} .zevvar-showcase__intro {
      grid-column: 1 / -1;
      min-height: 240px;
      padding: 32px 25px;
    }

    #zevvar-showcase-{{ section.id }} .zevvar-showcase__intro-content {
      max-width: 76%;
    }

    #zevvar-showcase-{{ section.id }} .zevvar-showcase__eyebrow {
      margin-bottom: 9px;
      font-size: 13px;
    }

    #zevvar-showcase-{{ section.id }} .zevvar-showcase__heading {
      margin-bottom: 12px;
      font-size: clamp(29px, 7vw, 40px);
    }

    #zevvar-showcase-{{ section.id }} .zevvar-showcase__description {
      font-size: 13px;
      line-height: 1.5;
    }

    #zevvar-showcase-{{ section.id }} .zevvar-showcase__button {
      margin-top: 17px;
      padding: 11px 17px;
      gap: 9px;
      font-size: 10px;
    }

    #zevvar-showcase-{{ section.id }} .zevvar-showcase__ornament {
      top: -5px;
      right: -13px;
      width: 145px;
      opacity: .55;
    }

    #zevvar-showcase-{{ section.id }} .zevvar-showcase__card {
      min-height: {{ section.settings.mobile_card_height }}px;
    }

    #zevvar-showcase-{{ section.id }} .zevvar-showcase__card-content {
      right: 10px;
      bottom: 13px;
      left: 10px;
    }

    #zevvar-showcase-{{ section.id }} .zevvar-showcase__card-title {
      margin-bottom: 7px;
      font-size: clamp(17px, 4.5vw, 22px);
    }

    #zevvar-showcase-{{ section.id }} .zevvar-showcase__card-link {
      gap: 6px;
      font-size: 11px;
    }

    #zevvar-showcase-{{ section.id }} .zevvar-showcase__card-arrow {
      width: 20px;
      height: 20px;
    }
  }

  @media screen and (max-width: 360px) {
    #zevvar-showcase-{{ section.id }} .zevvar-showcase__intro {
      padding: 27px 18px;
      min-height: 225px;
    }

    #zevvar-showcase-{{ section.id }} .zevvar-showcase__intro-content {
      max-width: 82%;
    }

    #zevvar-showcase-{{ section.id }} .zevvar-showcase__card {
      min-height: 205px;
    }

    #zevvar-showcase-{{ section.id }} .zevvar-showcase__card-content {
      right: 8px;
      left: 8px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #zevvar-showcase-{{ section.id }} .zevvar-showcase__ornament {
      animation: none;
    }

    #zevvar-showcase-{{ section.id }} .zevvar-showcase__image,
    #zevvar-showcase-{{ section.id }} .zevvar-showcase__button,
    #zevvar-showcase-{{ section.id }} .zevvar-showcase__card-arrow {
      transition: none;
    }
  }
</style>

{% schema %}
{
  "name": "ZEVVAR collection",
  "tag": "section",
  "class": "section-zevvar-collections",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "Our Collections"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Main heading",
      "default": "Embrace\nTimeless Beauty"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>From classic elegance to modern minimalism, find the perfect piece for every occasion.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Show introduction button",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button text",
      "default": "Explore Collections"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "show_ornament",
      "label": "Show animated gold ornament",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_card_link",
      "label": "Show Shop Now text on cards",
      "default": true
    },
    {
      "type": "text",
      "id": "card_link_label",
      "label": "Card link text",
      "default": "Shop Now"
    },
    {
      "type": "range",
      "id": "intro_width",
      "label": "Introduction panel width ratio",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "desktop_height",
      "label": "Desktop section height",
      "min": 280,
      "max": 650,
      "step": 10,
      "default": 340,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_card_height",
      "label": "Mobile collection card height",
      "min": 170,
      "max": 360,
      "step": 10,
      "default": 230,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Gap between cards",
      "min": 0,
      "max": 12,
      "step": 1,
      "default": 5,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Burgundy background",
      "default": "#79052E"
    },
    {
      "type": "color",
      "id": "gold_color",
      "label": "Gold ornament and accent",
      "default": "#C9A15A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Introduction text",
      "default": "#F7F2E8"
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "Collection card text",
      "default": "#FFFFFF"
    }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Collection card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Choose collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom card image",
          "info": "Optional. If empty, the collection's featured image will be used."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom card title",
          "info": "Optional. If empty, the collection title will be used."
        },
        {
          "type": "url",
          "id": "custom_link",
          "label": "Custom destination",
          "info": "Optional. Leave empty to link directly to the selected collection."
        }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "ZEVVAR collection",
      "blocks": [
        {
          "type": "collection_card"
        },
        {
          "type": "collection_card"
        },
        {
          "type": "collection_card"
        }
      ]
    }
  ]
}
{% endschema %}
