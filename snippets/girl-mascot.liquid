{% comment %}
  GIRL MASCOT
  CSS + HTML + JavaScript
  Render in theme.liquid: {% render 'girl-mascot' %}
{% endcomment %}

<style>
  #shopify-cat {
  --cat-center-scale: 1.7;
  transform-origin: 50% 50%;
  transition: transform 450ms cubic-bezier(.34, 1.3, .64, 1);
  will-change: transform;
}

#shopify-cat.is-center {
  transform:
    translate(
      calc(-50vw + var(--cat-right) + var(--cat-size) / 2),
      calc(-50vh + var(--cat-bottom) + var(--cat-size) / 2)
    )
    scale(var(--cat-center-scale));
}

@media (max-width: 600px) {
  #shopify-cat { --cat-center-scale: 1.5; }
}

@media (prefers-reduced-motion: reduce) {
  #shopify-cat { transition: none !important; }
}
  #shopify-cat {
    --cat-size: clamp(78px, 11vw, 120px);
    --cat-bottom: 22px;
    --cat-right: 22px;

    position: fixed;
    right: var(--cat-right);
    bottom: var(--cat-bottom);
    z-index: 9998;
    width: var(--cat-size);
    font-family: inherit;
    line-height: 1;
    text-align: center;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  #shopify-cat .cat-stage {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: visible;
    cursor: pointer;
    transform-origin: 50% 85%;
    animation: shopify-cat-float 3s ease-in-out infinite;
  }

  /* Sprite wrapper: receives the "pop" animation */
  #shopify-cat .cat-sprite {
    position: absolute;
    inset: 0;
    transform-origin: 50% 90%;
    pointer-events: none;
    filter: drop-shadow(0 5px 5px rgb(0 0 0 / 10%));
  }

  #shopify-cat .cat-sprite.is-pop {
    animation: shopify-cat-pop 520ms cubic-bezier(.34, 1.56, .64, 1);
  }

  /* Two stacked frames = smooth crossfade between images */
  #shopify-cat .cat-frame {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0;
    transition: opacity var(--cat-fade, 120ms) ease;
    -webkit-user-drag: none;
    pointer-events: none;
  }

  #shopify-cat .cat-frame.is-active {
    opacity: 1;
  }

  #shopify-cat .cat-bubble {
    position: absolute;
    right: 72%;
    bottom: 68%;
    width: max-content;
    max-width: min(190px, 55vw);
    padding: 9px 12px;
    border: 1px solid rgb(0 0 0 / 8%);
    border-radius: 14px 14px 4px 14px;
    background: #fff;
    color: #252525;
    font-size: 12px;
    font-weight: 600;
    line-height: 1.35;
    box-shadow: 0 4px 18px rgb(0 0 0 / 10%);
    opacity: 0;
    visibility: hidden;
    transform: translateY(5px) scale(.96);
    transform-origin: bottom right;
    transition: opacity 180ms ease, transform 180ms ease, visibility 180ms ease;
    pointer-events: none;
  }

  #shopify-cat .cat-bubble.is-visible {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
  }

  #shopify-cat .cat-stage:focus-visible {
    outline: 2px solid #777;
    outline-offset: 4px;
    border-radius: 50%;
  }

  #shopify-cat .cat-stage:active {
    transform: scale(.96);
  }

  @keyframes shopify-cat-float {
    0%, 100% { translate: 0 0; }
    50% { translate: 0 -5px; }
  }

  @keyframes shopify-cat-pop {
    0%   { transform: scale(.86) translateY(8px); }
    55%  { transform: scale(1.08) translateY(-5px); }
    100% { transform: scale(1) translateY(0); }
  }

  @media (max-width: 600px) {
    #shopify-cat {
      --cat-size: clamp(66px, 20vw, 84px);
      --cat-bottom: 14px;
      --cat-right: 12px;
    }

    #shopify-cat .cat-bubble {
      max-width: 145px;
      font-size: 11px;
      padding: 7px 9px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-cat .cat-stage { animation: none !important; }
    #shopify-cat .cat-sprite.is-pop { animation: none !important; }
    #shopify-cat .cat-frame,
    #shopify-cat .cat-bubble { transition: none !important; }
  }
</style>

<div id="shopify-cat" aria-label="Store mascot">
  <div
    class="cat-stage"
    id="cat-stage"
    role="button"
    tabindex="0"
    aria-label="Interact with the mascot"
    aria-describedby="cat-bubble"
  >
    <div class="cat-sprite" id="cat-sprite">
      <img
        class="cat-frame is-active"
        id="cat-frame-a"
        src="https://cdn.shopify.com/s/files/1/0638/3632/3911/files/idel-1.png?v=1792496194"
        alt="Cute mascot"
        width="256"
        height="256"
        loading="eager"
        decoding="async"
        draggable="false"
      >
      <img
        class="cat-frame"
        id="cat-frame-b"
        alt=""
        width="256"
        height="256"
        decoding="async"
        draggable="false"
      >
    </div>

    <div class="cat-bubble" id="cat-bubble" role="status" aria-live="polite">Hi there! 🐾</div>
  </div>
</div>

<script>
(() => {
  'use strict';

  const root   = document.getElementById('shopify-cat');
  const stage  = document.getElementById('cat-stage');
  const sprite = document.getElementById('cat-sprite');
  const frameA = document.getElementById('cat-frame-a');
  const frameB = document.getElementById('cat-frame-b');
  const bubble = document.getElementById('cat-bubble');

  if (!root || !stage || !sprite || !frameA || !frameB || !bubble) return;
  if (root.dataset.initialized === 'true') return;
  root.dataset.initialized = 'true';

  // =====================================================
  // IMAGES
  // Upload your images to Shopify > Content > Files with these names:
  //   cat-idel-1..4.png   cat-hover-1..4.png   cat-add-1..4.png
  //   cat-buy-1..4.png    cat-bored-1..4.png   cat-happy-1..4.png
  //   cat-curious-1..4.png
  // (Change the prefixes below if you name them differently.)
  // Any image that fails to load is skipped automatically, and a mode
  // with no images falls back to the idle frames.
  // =====================================================

  const BASE    = 'https://cdn.shopify.com/s/files/1/0638/3632/3911/files/';
  const VERSION = '?v=1791732572';
  const COUNT   = 4;

  const makeFrames = (prefix) =>
    Array.from({ length: COUNT }, (_, i) => `${BASE}${prefix}-${i + 1}.png${VERSION}`);

  const FRAMES = {
    idle: [
    'https://cdn.shopify.com/s/files/1/0638/3632/3911/files/idel-1.png?v=1792496194',
    'https://cdn.shopify.com/s/files/1/0638/3632/3911/files/idel-2.png?v=1792496194',
    'https://cdn.shopify.com/s/files/1/0638/3632/3911/files/idel-3.png?v=1792496194',
    'https://cdn.shopify.com/s/files/1/0638/3632/3911/files/idel-4.png?v=1792496194'
  ],
    hover: [
    'https://cdn.shopify.com/s/files/1/0638/3632/3911/files/hover-1.png?v=1792498058',
    'https://cdn.shopify.com/s/files/1/0638/3632/3911/files/hover-2.png?v=1792498058',
    'https://cdn.shopify.com/s/files/1/0638/3632/3911/files/hover-3.png?v=1792498059',
    'https://cdn.shopify.com/s/files/1/0638/3632/3911/files/hover-4.png?v=1792498059'
  ],
    add: [
  'https://cdn.shopify.com/s/files/1/0638/3632/3911/files/add-to-cart-1.png?v=1792498824',
  'https://cdn.shopify.com/s/files/1/0638/3632/3911/files/add-to-cart-2.png?v=1792498822',
  'https://cdn.shopify.com/s/files/1/0638/3632/3911/files/add-to-cart-3.png?v=1792498823',
  'https://cdn.shopify.com/s/files/1/0638/3632/3911/files/add-to-cart-4.png?v=1792498823'
  ],
    buy: [
  'https://cdn.shopify.com/s/files/1/0638/3632/3911/files/buy-1.png?v=1792499196',
  'https://cdn.shopify.com/s/files/1/0638/3632/3911/files/buy-2.png?v=1792499197',
  'https://cdn.shopify.com/s/files/1/0638/3632/3911/files/buy-3.png?v=1792499197',
  'https://cdn.shopify.com/s/files/1/0638/3632/3911/files/buy-4.png?v=1792499198'
  ],
    bored: [
  'https://cdn.shopify.com/s/files/1/0638/3632/3911/files/bored-1.png?v=1792501861',
  'https://cdn.shopify.com/s/files/1/0638/3632/3911/files/bored-2.png?v=1792501861',
  'https://cdn.shopify.com/s/files/1/0638/3632/3911/files/bored-3.png?v=1792501861',
  'https://cdn.shopify.com/s/files/1/0638/3632/3911/files/bored-4.png?v=1792501860'
  ],
    happy: [
  'https://cdn.shopify.com/s/files/1/0638/3632/3911/files/happy-1.png?v=1792502107',
  'https://cdn.shopify.com/s/files/1/0638/3632/3911/files/happy-2.png?v=1792502107',
  'https://cdn.shopify.com/s/files/1/0638/3632/3911/files/happy-3.png?v=1792502108',
  'https://cdn.shopify.com/s/files/1/0638/3632/3911/files/happy-4.png?v=1792502109'
  ],
    curious: [
  'https://cdn.shopify.com/s/files/1/0638/3632/3911/files/curios-1.png?v=1792502331',
  'https://cdn.shopify.com/s/files/1/0638/3632/3911/files/curios-2.png?v=1792502332',
  'https://cdn.shopify.com/s/files/1/0638/3632/3911/files/curios-3.png?v=1792502331',
  'https://cdn.shopify.com/s/files/1/0638/3632/3911/files/curios-4.png?v=1792502331'
]
  };

  // =====================================================
  // MODE SETTINGS
  // speed = ms per frame | loops = how many times the 4 images repeat
  // loop: true = repeats forever (idle only)
  // priority = higher modes can't be interrupted by lower ones
  // =====================================================

  const MODES = {
    idle:    { speed: 420, loop: true, priority: 0 },
    bored:   { speed: 450, loops: 2,   priority: 1 },
    hover:   { speed: 170, loops: 2,   priority: 2 },
    curious: { speed: 220, loops: 2,   priority: 2 },
    happy:   { speed: 200, loops: 2,   priority: 3 },
    add:     { speed: 200, loops: 2,   priority: 4 },
    buy:     { speed: 200, loops: 2,   priority: 4 }
  };

  const MESSAGES = {
    idle:    'Hi there! 🐾',
    hover:   'Hey, you found me! 😸',
    add:     'Yay! Added to your cart! 💖',
    buy:     'Let’s go! ✨',
    bored:   'Psst… still browsing? 😴',
    happy:   'That makes me happy! 😻',
    curious: 'Ooh, what’s this? 👀'
  };

  const INACTIVITY_MS = 7000;
  const CENTER_MODES = ['curious', 'add', 'buy'];
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  // ---------- Preload & track which images actually load ----------
  const loaded = {};
  Object.keys(FRAMES).forEach((mode) => {
    loaded[mode] = new Array(FRAMES[mode].length).fill(false);
    FRAMES[mode].forEach((src, i) => {
      const img = new Image();
      img.onload  = () => { loaded[mode][i] = true; };
      img.onerror = () => { loaded[mode][i] = false; };
      img.src = src;
    });
  });

  function getFrames(mode) {
    const ok = FRAMES[mode].filter((_, i) => loaded[mode][i]);
    if (ok.length) return ok;
    const idleOk = FRAMES.idle.filter((_, i) => loaded.idle[i]);
    return idleOk.length ? idleOk : [FRAMES.idle[0]];
  }

  // ---------- State ----------
  let currentMode = 'idle';
  let token = 0;
  let frameTimer = null;
  let inactivityTimer = null;
  let bubbleTimer = null;
  let front = frameA;
  let back = frameB;

  // ---------- Smooth frame swap (crossfade) ----------
  function showFrame(src, fadeMs) {
    root.style.setProperty('--cat-fade', fadeMs + 'ms');

    if (front.getAttribute('src') === src) return;

    back.src = src;
    back.classList.add('is-active');
    front.classList.remove('is-active');

    const tmp = front;
    front = back;
    back = tmp;
  }

  function popSprite() {
    sprite.classList.remove('is-pop');
    void sprite.offsetWidth; // restart the animation
    sprite.classList.add('is-pop');
  }

  // ---------- Speech bubble ----------
  function showBubble(mode, duration) {
    bubble.textContent = MESSAGES[mode] || MESSAGES.idle;
    bubble.classList.add('is-visible');
    clearTimeout(bubbleTimer);
    if (duration > 0) {
      bubbleTimer = setTimeout(() => bubble.classList.remove('is-visible'), duration);
    }
  }

  function hideBubble() {
    clearTimeout(bubbleTimer);
    bubble.classList.remove('is-visible');
  }

  // ---------- Animation engine ----------
  function run(mode, options = {}) {
    if (!MODES[mode]) mode = 'idle';

    const { message = true, force = false } = options;
    const cfg = MODES[mode];

    if (!force) {
      // Lower-priority modes can't interrupt a higher one
      if (cfg.priority < MODES[currentMode].priority) return;
      // Don't restart the same action while it is still playing
      if (mode === currentMode && mode !== 'idle') return;
    }

    clearTimeout(frameTimer);
    token += 1;
    const myToken = token;

    currentMode = mode;
    root.classList.toggle('is-center', CENTER_MODES.includes(mode));

    const frames = getFrames(mode);
    const fade = Math.min(Math.round(cfg.speed * 0.6), 140);
    const total = cfg.loop ? Infinity : frames.length * cfg.loops;
    let step = 0;

    showFrame(frames[0], fade);

    if (mode !== 'idle') popSprite();
    if (message && mode !== 'idle') showBubble(mode, Math.max(1800, total * cfg.speed));

    function finish() {
      if (myToken !== token) return;
      if (mode !== 'idle') {
        run('idle', { message: false, force: true });
        resetInactivity();
      }
    }

    // Reduced motion: no frame cycling, just hold and return to idle
    if (reducedMotion.matches) {
      if (mode !== 'idle') frameTimer = setTimeout(finish, 1600);
      return;
    }

    if (frames.length < 2 && mode === 'idle') return;

    function tick() {
      if (myToken !== token) return;

      step += 1;
      if (step >= total) {
        finish();
        return;
      }

      showFrame(frames[step % frames.length], fade);
      frameTimer = setTimeout(tick, cfg.speed);
    }

    frameTimer = setTimeout(tick, cfg.speed);
  }

  // ---------- Inactivity -> bored ----------
  function resetInactivity() {
    clearTimeout(inactivityTimer);
    inactivityTimer = setTimeout(() => {
      if (currentMode === 'idle') run('bored');
    }, INACTIVITY_MS);
  }

  function recordActivity() {
    resetInactivity();
    if (currentMode === 'bored') {
      hideBubble();
      run('idle', { message: false, force: true });
    }
  }

  // =====================================================
  // MASCOT INTERACTIONS
  // =====================================================

  stage.addEventListener('pointerenter', (e) => {
    if (e.pointerType === 'touch') return;
    recordActivity();
    run('hover');
  });

  stage.addEventListener('pointerleave', (e) => {
    if (e.pointerType === 'touch') return;
    if (currentMode === 'hover') {
      hideBubble();
      run('idle', { message: false, force: true });
    }
    resetInactivity();
  });

  const triggerCurious = () => {
    recordActivity();
    run('curious');
  };

  stage.addEventListener('focus', triggerCurious);
  stage.addEventListener('click', triggerCurious);
  stage.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      triggerCurious();
    }
  });

  // =====================================================
  // SHOPIFY ADD TO CART / BUY NOW
  // =====================================================

  const ADD_BUTTONS = [
    'form[action*="/cart/add"] button[type="submit"]',
    'form[action*="/cart/add"] [type="submit"]',
    'button[name="add"]',
    '.add-to-cart',
    '[data-add-to-cart]',
    '[data-product-submit]'
  ].join(',');

  const BUY_BUTTONS = [
    '.shopify-payment-button__button',
    '[data-buy-now]',
    'button[name="checkout"]',
    'form[action="/checkout"] [type="submit"]'
  ].join(',');

  document.addEventListener('click', (event) => {
    const target = event.target instanceof Element
      ? event.target
      : event.target && event.target.parentElement;

    if (!target || target.closest('#shopify-cat')) return;

    if (target.closest(BUY_BUTTONS)) {
      recordActivity();
      run('buy');
      return;
    }

    if (target.closest(ADD_BUTTONS)) {
      recordActivity();
      run('add');
    }
  }, true);

  // Themes that add to cart via AJAX: trigger when /cart/add succeeds
  if (typeof window.fetch === 'function' && !window.__catFetchPatched) {
    window.__catFetchPatched = true;
    const originalFetch = window.fetch;

    window.fetch = function (...args) {
      const promise = originalFetch.apply(this, args);

      try {
        const input = args[0];
        const url = typeof input === 'string' ? input : (input && input.url) || '';

        if (/\/cart\/add/.test(url)) {
          promise.then((res) => {
            if (res && res.ok) {
              recordActivity();
              run('add');
            }
          }).catch(() => {});
        }
      } catch (e) { /* never break the store's own requests */ }

      return promise;
    };
  }

  // Common theme cart events
  ['cart:updated', 'cart:refresh', 'product:added'].forEach((name) => {
    document.addEventListener(name, () => {
      recordActivity();
      run('happy');
    });
  });

  // Page activity resets the boredom timer
  window.addEventListener('pointerdown', recordActivity, { passive: true });
  window.addEventListener('keydown', recordActivity);
  window.addEventListener('scroll', recordActivity, { passive: true });

  // =====================================================
  // START
  // =====================================================

  run('idle', { message: false, force: true });
  resetInactivity();
})();
</script>