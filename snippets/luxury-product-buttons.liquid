
{% if product != blank %}
  {% assign luxury_variant = product.selected_or_first_available_variant %}

  {{ 'luxury-product-buttons.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'luxury-product-buttons.js' | asset_url }}" defer></script>

  <div
    class="luxury-actions"
    data-luxury-actions
    data-product-id="{{ product.id }}"
    data-product-title="{{ product.title | escape }}"
    data-product-url="{{ product.url | escape }}"
    data-initial-variant-id="{{ luxury_variant.id }}"
    data-current-variant-id="{{ luxury_variant.id }}"
    data-current-variant-available="{{ luxury_variant.available }}"
    data-variant-data='[
      {% for variant in product.variants %}
        {
          "id": {{ variant.id | json }},
          "available": {{ variant.available | json }}
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ]'
  >
    <div class="luxury-actions__form" data-luxury-form>
      <input
        type="hidden"
        name="id"
        value="{{ luxury_variant.id }}"
      >

      <button
        type="button"
        class="luxury-actions__button luxury-actions__button--bag"
        data-luxury-add
        {% unless luxury_variant.available %}disabled{% endunless %}
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none">
          <path d="M5 8h14l1 13H4L5 8Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
          <path d="M9 9V6a3 3 0 0 1 6 0v3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        <span>ADD TO BAG</span>
      </button>

      <div class="luxury-actions__stack">
        <button
          type="button"
          class="luxury-actions__button luxury-actions__button--small luxury-actions__button--wish"
          data-luxury-wishlist
          aria-label="Add to wishlist"
          aria-pressed="false"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="none">
            <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1.1L12 21l7.8-7.5 1.1-1.1a5.5 5.5 0 0 0-.1-7.8Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
          </svg>
        </button>

        <button
          type="button"
          class="luxury-actions__button luxury-actions__button--small luxury-actions__button--share"
          data-luxury-share
          aria-label="Share product"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="none">
            <circle cx="18" cy="5" r="3" stroke="currentColor" stroke-width="1.5"/>
            <circle cx="6" cy="12" r="3" stroke="currentColor" stroke-width="1.5"/>
            <circle cx="18" cy="19" r="3" stroke="currentColor" stroke-width="1.5"/>
            <path d="m8.7 10.6 6.6-4.2M8.7 13.4l6.6 4.2" stroke="currentColor" stroke-width="1.5"/>
          </svg>
        </button>
      </div>

      <button
        type="button"
        class="luxury-actions__button luxury-actions__button--buy"
        data-luxury-buy
        {% unless luxury_variant.available %}disabled{% endunless %}
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none">
          <path d="m12 3 2.3 4.7 5.2.8-3.8 3.7.9 5.2-4.6-2.4-4.6 2.4.9-5.2-3.8-3.7 5.2-.8L12 3Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
          <path d="M5 21h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        <span>BUY IT NOW</span>
      </button>
    </div>

    <div
      class="luxury-actions__status"
      data-luxury-status
      role="status"
      aria-live="polite"
    ></div>
  </div>
{% endif %}
